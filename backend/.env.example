APP_NAME="Saanj Garva"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.yourdomain.com
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL (Neon Singapore or standard PG)
DB_CONNECTION=pgsql
# Neon connection string option:
# DB_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sanj_garva
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer

# Optional: Set to true in container deployments to auto-run migrations on launch
AUTORUN_MIGRATIONS=false
FIRST_RUN_SEED=false

# Frontend origin(s) allowed by CORS (comma-separated, no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
# Optional regex for Vercel preview URLs, e.g. ^https://saanj-garva-.*\.vercel\.app$
FRONTEND_URL_PATTERN=

# Owner account created by `php artisan db:seed` (change the password after first login)
ADMIN_NAME=Owner
ADMIN_EMAIL=owner@sanjgarva.in
ADMIN_MOBILE=9999999999
ADMIN_PASSWORD=ChangeMe@123

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
